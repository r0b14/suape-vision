# Flask
FLASK_DEBUG=false

# Azure Custom Vision (módulo suape/getContainers)
AZURE_PREDICTION_KEY=your_azure_prediction_key_here
AZURE_PREDICTION_URL=https://containers-prediction.cognitiveservices.azure.com/customvision/v3.0/Prediction/PROJECT_ID/detect/iterations/containers/url
